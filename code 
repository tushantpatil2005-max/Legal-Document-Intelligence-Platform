class LegalReranker:
    """
    Second-stage reranker operating on top-K hybrid candidates.
    Supports:
      - Cross-Encoder model via sentence-transformers (optional)
      - LLM pointwise relevance scoring via OpenAI-compatible chat API (optional)
      - Multi-signal legal reranker (exact phrase match, section header match,
        query term coverage, proximity density, and semantic similarity)
    """

    def __init__(self) -> None:
        self.api_key = os.environ.get("OPENAI_API_KEY", "").strip()
        self.api_base = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1").rstrip("/")
        self.chat_model = os.environ.get("CHAT_MODEL", "gpt-4o-mini")
        self._cross_encoder = None
        if os.environ.get("USE_CROSS_ENCODER", "0") == "1":
            try:
                from sentence_transformers import CrossEncoder  # type: ignore
                model_name = os.environ.get("CROSS_ENCODER_MODEL", "cross-encoder/ms-marco-MiniLM-L-6-v2")
                self._cross_encoder = CrossEncoder(model_name)
            except Exception:
                self._cross_encoder = None

    def rerank(
        self,
        query: str,
        candidates: List[RetrievalCandidate],
        top_n: int = 6,
    ) -> List[RetrievalCandidate]:
        if not candidates:
            return []

        if self._cross_encoder is not None:
            pairs = [(query, f"{c.chunk.section_title}: {c.chunk.text}") for c in candidates]
            raw_scores = self._cross_encoder.predict(pairs)
            for cand, sc in zip(candidates, raw_scores):
                cand.rerank_score = float(1.0 / (1.0 + math.exp(-float(sc))))
                cand.rerank_reason = "Cross-encoder passage relevance score"
        else:
            self._score_structural(query, candidates)
            if self.api_key and len(candidates) <= 15:
                self._blend_llm_rerank(query, candidates)

        candidates.sort(key=lambda c: c.rerank_score, reverse=True)
        for rank, cand in enumerate(candidates, start=1):
            cand.final_rank = rank
        return candidates[:top_n]

    def _score_structural(self, query: str, candidates: List[RetrievalCandidate]) -> None:
        q_tokens = tokenize(query)
        q_set = set(q_tokens)
        q_bigrams = {f"{q_tokens[i]} {q_tokens[i+1]}" for i in range(len(q_tokens) - 1)}
        q_lower = query.lower()

        max_bm25 = max((c.bm25_score for c in candidates), default=1.0) or 1.0

        for cand in candidates:
            ch = cand.chunk
            text_lower = ch.text.lower()
            title_lower = f"{ch.section_title} {ch.clause_category}".lower()
            doc_tokens = set(tokenize(text_lower))

            coverage = (len(q_set & doc_tokens) / len(q_set)) if q_set else 0.0
            title_hits = sum(1 for t in q_set if t in title_lower)
            title_score = min(1.0, title_hits / max(1, min(len(q_set), 3)))
            bigram_hits = sum(1 for bg in q_bigrams if bg in text_lower)
            phrase_score = min(1.0, bigram_hits / max(1, len(q_bigrams))) if q_bigrams else 0.0

            # Boost when query asks about numeric caps/days/notice periods and passage contains them
            wants_quant = bool(re.search(r"\b(how many|how long|days|months|years|percent|cap|amount|fee|limit|notice|hours)\b", q_lower))
            has_quant = bool(re.search(r"(\$\d|\d+%|\b\d+\s*(?:days?|hours?|months?|years?|business days?)\b)", text_lower))
            quant_bonus = 0.12 if (wants_quant and has_quant) else 0.0

            norm_bm25 = cand.bm25_score / max_bm25
            dense_clamped = max(0.0, cand.dense_score)

            score = (
                0.30 * dense_clamped
                + 0.22 * norm_bm25
                + 0.22 * coverage
                + 0.16 * title_score
                + 0.10 * phrase_score
                + quant_bonus
            )
            cand.rerank_score = round(min(0.99, score), 4)

            reasons: List[str] = []
            if title_score >= 0.5:
                reasons.append(f"section heading match ({ch.section_title})")
            if phrase_score > 0:
                reasons.append("exact legal phrase overlap")
            if quant_bonus > 0:
                reasons.append("contains concrete numeric/temporal threshold")
            if coverage >= 0.5:
                reasons.append(f"{int(coverage * 100)}% query term coverage")
            cand.rerank_reason = "; ".join(reasons) if reasons else "combined dense and lexical relevance"

    def _blend_llm_rerank(self, query: str, candidates: List[RetrievalCandidate]) -> None:
        items_text = "\n".join(
            f"[{i}] ({c.chunk.citation_label}): {c.chunk.text[:450]}"
            for i, c in enumerate(candidates)
        )
        prompt = (
            "Score each legal passage from 0.0 to 1.0 for directly answering the legal question. "
            'Return strict JSON: {"scores": [{"index": 0, "score": 0.92, "reason": "..."}]}.\n\n'
            f"Question: {query}\n\nPassages:\n{items_text}"
        )
        payload = json.dumps({
            "model": self.chat_model,
            "temperature": 0.0,
            "response_format": {"type": "json_object"},
            "messages": [
                {"role": "system", "content": "You are a precise legal retrieval reranker."},
                {"role": "user", "content": prompt},
            ],
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{self.api_base}/chat/completions",
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                body = json.loads(resp.read().decode("utf-8"))
                content = body["choices"][0]["message"]["content"]
                parsed = json.loads(content)
                for row in parsed.get("scores", []):
                    idx = int(row["index"])
                    if 0 <= idx < len(candidates):
                        llm_sc = max(0.0, min(1.0, float(row["score"])))
                        candidates[idx].rerank_score = round(
                            0.7 * llm_sc + 0.3 * candidates[idx].rerank_score, 4
                        )
                        if row.get("reason"):
                            candidates[idx].rerank_reason = str(row["reason"])
        except Exception:
            return



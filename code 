# ---------------------------------------------------------------------------
# Optional HTTP Server (FastAPI)
# ---------------------------------------------------------------------------

def run_http_server(platform: LegalIntelligencePlatform, host: str, port: int) -> None:
    try:
        from fastapi import FastAPI, HTTPException  # type: ignore
        from pydantic import BaseModel  # type: ignore
        import uvicorn  # type: ignore
    except ImportError as exc:
        raise SystemExit(
            "HTTP server requires fastapi and uvicorn: pip install fastapi uvicorn"
        ) from exc

    app = FastAPI(title="Legal Document Intelligence Platform", version="1.0.0")

    class FilterPayload(BaseModel):
        doc_ids: Optional[List[str]] = None
        doc_types: Optional[List[str]] = None
        jurisdictions: Optional[List[str]] = None
        parties: Optional[List[str]] = None
        clause_categories: Optional[List[str]] = None
        confidentiality: Optional[List[str]] = None
        year_from: Optional[int] = None
        year_to: Optional[int] = None

    class QueryPayload(BaseModel):
        query: str
        top_n: int = 5
        filters: Optional[FilterPayload] = None

    class ClausePayload(BaseModel):
        clause_category: str
        top_n: int = 8
        filters: Optional[FilterPayload] = None

    class IngestPayload(BaseModel):
        doc_id: Optional[str] = None
        title: str
        doc_type: str = "Contract"
        jurisdiction: str = "Delaware, US"
        effective_date: str = "2025-01-01"
        parties: List[str] = ["Party A", "Party B"]
        confidentiality: str = "Confidential"
        text: str

    @app.get("/documents")
    def list_docs() -> List[Dict[str, Any]]:
        return [
            {
                "doc_id": d.doc_id,
                "title": d.title,
                "doc_type": d.doc_type,
                "jurisdiction": d.jurisdiction,
                "effective_date": d.effective_date,
                "parties": d.parties,
                "confidentiality": d.confidentiality,
                "page_count": d.page_count,
            }
            for d in platform.store.list_documents()
        ]

    @app.post("/ingest")
    def ingest(payload: IngestPayload) -> Dict[str, Any]:
        doc_id = payload.doc_id or hashlib.sha1(payload.title.encode("utf-8")).hexdigest()[:12]
        doc = LegalDocument(
            doc_id=doc_id,
            title=payload.title,
            doc_type=payload.doc_type,
            jurisdiction=payload.jurisdiction,
            effective_date=payload.effective_date,
            parties=payload.parties,
            confidentiality=payload.confidentiality,
            raw_text=payload.text,
        )
        chunks_created = platform.ingest_document(doc)
        return {"doc_id": doc_id, "chunks_indexed": chunks_created}

    @app.post("/query")
    def query_endpoint(payload: QueryPayload) -> Dict[str, Any]:
        flt = MetadataFilter(**payload.filters.model_dump()) if payload.filters else None
        result = platform.answer_question(payload.query, filters=flt, top_n=payload.top_n)
        return asdict(result)

    @app.post("/clauses")
    def clause_endpoint(payload: ClausePayload) -> Dict[str, Any]:
        flt = MetadataFilter(**payload.filters.model_dump()) if payload.filters else None
        spans = platform.find_clauses(payload.clause_category, filters=flt, top_n=payload.top_n)
        return {"clause_category": payload.clause_category, "matches": [asdict(s) for s in spans]}

    @app.get("/summarize/{doc_id}")
    def summarize_endpoint(doc_id: str) -> Dict[str, Any]:
        try:
            return platform.summarize_document(doc_id)
        except KeyError as exc:
            raise HTTPException(status_code=404, detail=str(exc)) from exc

    uvicorn.run(app, host=host, port=port)


# ---------------------------------------------------------------------------
# Command-Line Interface
# ---------------------------------------------------------------------------

def build_filter_from_args(args: argparse.Namespace) -> MetadataFilter:
    return MetadataFilter(
        doc_ids=args.doc_id or None,
        doc_types=args.doc_type or None,
        jurisdictions=args.jurisdiction or None,
        parties=args.party or None,
        clause_categories=args.clause or None,
        confidentiality=args.confidentiality or None,
        year_from=args.year_from,
        year_to=args.year_to,
    )


def add_filter_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--doc-id", action="append", help="Filter by document ID")
    parser.add_argument("--doc-type", action="append", help="Filter by document type")
    parser.add_argument("--jurisdiction", action="append", help="Filter by jurisdiction")
    parser.add_argument("--party", action="append", help="Filter by counterparty name")
    parser.add_argument("--clause", action="append", help="Filter by clause category")
    parser.add_argument("--confidentiality", action="append", help="Filter by confidentiality tier")
    parser.add_argument("--year-from", type=int, default=None, help="Minimum effective year")
    parser.add_argument("--year-to", type=int, default=None, help="Maximum effective year")


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="legal_intelligence.py",
        description="Legal Document Intelligence Platform — RAG retrieval, reranking, clause discovery, and summarization.",
    )
    parser.add_argument("--db", default=DEFAULT_DB_PATH, help="SQLite index database path")
    parser.add_argument("--chunk-words", type=int, default=DEFAULT_CHUNK_WORDS, help="Target words per chunk")
    parser.add_argument("--overlap-words", type=int, default=DEFAULT_CHUNK_OVERLAP, help="Word overlap between chunks")

    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("seed", help="Index the built-in multi-document legal sample corpus")

    p_ingest = sub.add_parser("ingest", help="Ingest a legal file (.txt, .md, .pdf, .json) or directory")
    p_ingest.add_argument("path", help="File or directory path")
    p_ingest.add_argument("--doc-type", default="Contract")
    p_ingest.add_argument("--jurisdiction", default="Delaware, US")
    p_ingest.add_argument("--effective-date", default="2025-01-01")
    p_ingest.add_argument("--party", action="append", default=[])
    p_ingest.add_argument("--confidentiality", default="Confidential")

    sub.add_parser("list-docs", help="List all indexed legal documents")

    p_query = sub.add_parser("query", help="Ask a legal question and receive a cited answer with evidence")
    p_query.add_argument("question", help="Legal question to answer")
    p_query.add_argument("--top-n", type=int, default=5)
    p_query.add_argument("--json", action="store_true", dest="as_json")
    add_filter_arguments(p_query)

    p_clauses = sub.add_parser("clauses", help="Locate relevant clauses across the corpus")
    p_clauses.add_argument("category", help=f"Clause category (e.g., {', '.join(CLAUSE_TAXONOMY.keys())})")
    p_clauses.add_argument("--top-n", type=int, default=8)
    p_clauses.add_argument("--json", action="store_true", dest="as_json")
    add_filter_arguments(p_clauses)

    p_sum = sub.add_parser("summarize", help="Generate a cited structured summary of an indexed document")
    p_sum.add_argument("doc_id", help="Indexed document ID")
    p_sum.add_argument("--json", action="store_true", dest="as_json")

    p_serve = sub.add_parser("serve", help="Run the REST API server (requires fastapi & uvicorn)")
    p_serve.add_argument("--host", default="0.0.0.0")
    p_serve.add_argument("--port", type=int, default=8000)

    args = parser.parse_args(argv)
    platform = LegalIntelligencePlatform(
        db_path=args.db,
        chunk_words=args.chunk_words,
        overlap_words=args.overlap_words,
    )

    if args.command == "seed":
        count = platform.seed_sample_corpus()
        print(f"Indexed {len(SAMPLE_LEGAL_CORPUS)} legal documents ({count} chunks) into {args.db}.")
        return 0

    if args.command == "ingest":
        target = Path(args.path)
        if not target.exists():
            print(f"Path not found: {target}", file=sys.stderr)
            return 1
        files = [target] if target.is_file() else [
            p for p in target.rglob("*") if p.suffix.lower() in {".txt", ".md", ".pdf", ".json"}
        ]
        total_chunks = 0
        for file_path in files:
            total_chunks += platform.ingest_file(
                file_path,
                doc_type=args.doc_type,
                jurisdiction=args.jurisdiction,
                effective_date=args.effective_date,
                parties=args.party or None,
                confidentiality=args.confidentiality,
            )
        print(f"Ingested {len(files)} file(s), indexed {total_chunks} chunk(s).")
        return 0

    if args.command == "list-docs":
        docs = platform.store.list_documents()
        if not docs:
            print("No documents indexed. Run 'seed' or 'ingest' first.")
            return 0
        for d in docs:
            print(
                f"{d.doc_id:<22} | {d.doc_type:<26} | {d.jurisdiction:<18} | "
                f"{d.effective_date} | {d.page_count}p | {d.title}"
            )
        return 0

    if args.command == "query":
        flt = build_filter_from_args(args)
        resp = platform.answer_question(args.question, filters=flt, top_n=args.top_n)
        if args.as_json:
            print(json.dumps(asdict(resp), indent=2))
            return 0
        print(f"\nQuestion: {resp.query}")
        print(f"Grounded: {'Yes' if resp.grounded else 'No'} (evaluated {resp.candidates_considered} filtered chunks)\n")
        print(resp.answer)
        if resp.citations:
            print("\nSupporting Evidence:")
            for ev in resp.citations:
                pages = f"p. {ev.page_start}" if ev.page_start == ev.page_end else f"pp. {ev.page_start}-{ev.page_end}"
                print(
                    f"  [{ev.citation_index}] {ev.doc_title} | {pages} | "
                    f"Sec. {ev.section_number} ({ev.section_title}) | "
                    f"Rerank: {ev.rerank_score:.3f} (Rank {ev.initial_rank} -> {ev.final_rank})"
                )
                print(f"      \"{ev.quote[:240]}{'...' if len(ev.quote) > 240 else ''}\"")
        return 0

    if args.command == "clauses":
        flt = build_filter_from_args(args)
        spans = platform.find_clauses(args.category, filters=flt, top_n=args.top_n)
        if args.as_json:
            print(json.dumps([asdict(s) for s in spans], indent=2))
            return 0
        print(f"\nClause Discovery: {args.category} ({len(spans)} matches)\n")
        for ev in spans:
            pages = f"p. {ev.page_start}" if ev.page_start == ev.page_end else f"pp. {ev.page_start}-{ev.page_end}"
            print(
                f"[{ev.citation_index}] {ev.doc_title} — {pages}, Sec. {ev.section_number} ({ev.section_title}) "
                f"[Category: {ev.clause_category}, Score: {ev.rerank_score:.3f}]"
            )
            print(f"    {ev.quote}\n")
        return 0

    if args.command == "summarize":
        summary = platform.summarize_document(args.doc_id)
        if args.as_json:
            print(json.dumps(summary, indent=2))
            return 0
        print(f"\nSummary: {summary['title']}")
        print(f"Type: {summary['doc_type']} | Jurisdiction: {summary['jurisdiction']} | Effective: {summary['effective_date']}\n")
        print(summary["executive_overview"])
        if summary.get("key_obligations"):
            print("\nKey Obligations:")
            for item in summary["key_obligations"]:
                print(f"  - {item['obligation']} [{item['reference']}]")
        if summary.get("key_thresholds_and_dates"):
            print("\nKey Thresholds & Dates:")
            for item in summary["key_thresholds_and_dates"]:
                print(f"  - {item['term']} [{item['reference']}]")
        if summary.get("risk_considerations"):
            print("\nRisk Considerations:")
            for item in summary["risk_considerations"]:
                print(f"  - ({item['category']}) {item['detail']} [{item['reference']}]")
        return 0

    if args.command == "serve":
        run_http_server(platform, host=args.host, port=args.port)
        return 0

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

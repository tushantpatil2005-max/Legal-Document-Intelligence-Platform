def tokenize(text: str) -> List[str]:
    tokens = re.findall(r"[a-z0-9]+(?:[-'][a-z0-9]+)*", text.lower())
    return [t for t in tokens if len(t) > 1 and t not in STOPWORDS]


def classify_clause(section_title: str, text: str) -> str:
    combined = f"{section_title} {text}".lower()
    best_cat = "General Provision"
    best_hits = 0
    for category, keywords in CLAUSE_TAXONOMY.items():
        hits = 0
        for kw in keywords:
            if kw in section_title.lower():
                hits += 3
            elif kw in combined:
                hits += 1
        if hits > best_hits:
            best_hits = hits
            best_cat = category
    return best_cat


def split_into_pages(raw_text: str) -> List[Tuple[int, str]]:
    """Extract explicit page boundaries from form feeds or page markers."""
    normalized = raw_text.replace("\r\n", "\n").replace("\r", "\n")
    if "\f" in normalized:
        parts = normalized.split("\f")
        return [(idx + 1, part.strip()) for idx, part in enumerate(parts) if part.strip()]

    markers = list(PAGE_MARKER_RE.finditer(normalized))
    if not markers:
        return [(1, normalized.strip())]

    pages: List[Tuple[int, str]] = []
    if markers[0].start() > 0:
        preamble = normalized[: markers[0].start()].strip()
        if preamble:
            pages.append((1, preamble))

    for i, match in enumerate(markers):
        page_num_str = match.group(1) or match.group(2) or match.group(3)
        page_num = int(page_num_str) if page_num_str else (len(pages) + 1)
        start = match.end()
        end = markers[i + 1].start() if i + 1 < len(markers) else len(normalized)
        body = normalized[start:end].strip()
        if body:
            pages.append((page_num, body))
    return pages or [(1, normalized.strip())]


class LegalChunker:
    """
    Hierarchical clause-aware chunker for legal documents.

    1. Segments document into pages while preserving exact page numbers.
    2. Detects legal section/article/clause headings and tracks active hierarchy.
    3. Packs paragraphs into chunks up to `chunk_words` with `overlap_words` tail
       carry-over so cross-paragraph obligations stay intact.
    4. Annotates every chunk with page range, section identifier, clause class,
       and character offsets.
    """

    def __init__(
        self,
        chunk_words: int = DEFAULT_CHUNK_WORDS,
        overlap_words: int = DEFAULT_CHUNK_OVERLAP,
    ) -> None:
        if overlap_words >= chunk_words:
            raise ValueError("overlap_words must be strictly less than chunk_words")
        self.chunk_words = chunk_words
        self.overlap_words = overlap_words

    def chunk_document(self, doc: LegalDocument) -> List[DocumentChunk]:
        pages = split_into_pages(doc.raw_text)
        doc.page_count = max((p for p, _ in pages), default=1)

        # Build structured blocks: (page_num, section_num, section_title, text, char_offset)
        blocks: List[Tuple[int, str, str, str, int]] = []
        current_sec_num = "0"
        current_sec_title = "Preamble"
        running_offset = 0

        for page_num, page_text in pages:
            paragraphs = [p.strip() for p in re.split(r"\n\s*\n", page_text) if p.strip()]
            for para in paragraphs:
                lines = [ln.strip() for ln in para.split("\n") if ln.strip()]
                if not lines:
                    continue
                first_line = lines[0]
                header_match = SECTION_HEADER_RE.match(first_line)
                if header_match:
                    sec_num = header_match.group(1) or header_match.group(3) or current_sec_num
                    sec_title = (header_match.group(2) or header_match.group(4) or "").strip(" .:-")
                    current_sec_num = sec_num
                    current_sec_title = sec_title or current_sec_title
                    body = "\n".join(lines[1:]).strip() if len(lines) > 1 else first_line
                    blocks.append((page_num, current_sec_num, current_sec_title, body, running_offset))
                else:
                    blocks.append((page_num, current_sec_num, current_sec_title, para, running_offset))
                running_offset += len(para) + 2

        chunks: List[DocumentChunk] = []
        chunk_idx = 0

        # Group contiguous blocks belonging to the same section before windowing
        grouped: List[List[Tuple[int, str, str, str, int]]] = []
        for blk in blocks:
            if grouped and grouped[-1][0][1] == blk[1] and grouped[-1][0][2] == blk[2]:
                grouped[-1].append(blk)
            else:
                grouped.append([blk])

        for group in grouped:
            sec_num = group[0][1]
            sec_title = group[0][2]
            words_with_meta: List[Tuple[str, int, int]] = []

            for page_num, _, _, text, offset in group:
                for w_match in re.finditer(r"\S+", text):
                    words_with_meta.append((w_match.group(0), page_num, offset + w_match.start()))

            if not words_with_meta:
                continue

            step = max(1, self.chunk_words - self.overlap_words)
            start_i = 0
            while start_i < len(words_with_meta):
                end_i = min(len(words_with_meta), start_i + self.chunk_words)
                window = words_with_meta[start_i:end_i]
                chunk_text = " ".join(w[0] for w in window)
                page_start = min(w[1] for w in window)
                page_end = max(w[1] for w in window)
                char_start = window[0][2]
                char_end = window[-1][2] + len(window[-1][0])

                cid_seed = f"{doc.doc_id}:{chunk_idx}:{sec_num}:{char_start}"
                chunk_id = hashlib.sha256(cid_seed.encode("utf-8")).hexdigest()[:16]
                clause_cat = classify_clause(sec_title, chunk_text)

                chunks.append(
                    DocumentChunk(
                        chunk_id=chunk_id,
                        doc_id=doc.doc_id,
                        doc_title=doc.title,
                        doc_type=doc.doc_type,
                        jurisdiction=doc.jurisdiction,
                        effective_date=doc.effective_date,
                        effective_year=doc.effective_year,
                        parties=list(doc.parties),
                        confidentiality=doc.confidentiality,
                        page_start=page_start,
                        page_end=page_end,
                        section_number=sec_num,
                        section_title=sec_title,
                        clause_category=clause_cat,
                        chunk_index=chunk_idx,
                        char_start=char_start,
                        char_end=char_end,
                        text=chunk_text,
                    )
                )
                chunk_idx += 1
                if end_i >= len(words_with_meta):
                    break
                start_i += step

        return chunks


# ---------------------------------------------------------------------------
# Embedding Providers (API, Local Sentence-Transformers, or Hashed Projection)
# ---------------------------------------------------------------------------

def _l2_normalize(vec: Sequence[float]) -> List[float]:
    norm = math.sqrt(sum(v * v for v in vec))
    if norm == 0.0:
        return [0.0 for _ in vec]
    return [v / norm for v in vec]


def cosine_similarity(a: Sequence[float], b: Sequence[float]) -> float:
    if not a or not b or len(a) != len(b):
        return 0.0
    return sum(x * y for x, y in zip(a, b))


class EmbeddingClient:
    """
    Produces normalized dense vectors for semantic search.
    Resolution order:
      1. OpenAI-compatible embeddings endpoint (if OPENAI_API_KEY is set)
      2. Local sentence-transformers model (if installed and enabled)
      3. Deterministic character+word n-gram signed random projection (zero deps)
    """

    def __init__(self, dim: int = DEFAULT_EMBEDDING_DIM) -> None:
        self.dim = dim
        self.api_key = os.environ.get("OPENAI_API_KEY", "").strip()
        self.api_base = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1").rstrip("/")
        self.embed_model = os.environ.get("EMBEDDING_MODEL", "text-embedding-3-small")
        self._st_model = None
        if not self.api_key and os.environ.get("USE_SENTENCE_TRANSFORMERS", "0") == "1":
            try:
                from sentence_transformers import SentenceTransformer  # type: ignore
                model_name = os.environ.get("ST_EMBEDDING_MODEL", "BAAI/bge-small-en-v1.5")
                self._st_model = SentenceTransformer(model_name)
            except Exception:
                self._st_model = None

    def embed_batch(self, texts: Sequence[str]) -> List[List[float]]:
        if not texts:
            return []
        if self.api_key:
            return self._embed_remote(texts)
        if self._st_model is not None:
            vectors = self._st_model.encode(list(texts), normalize_embeddings=True)
            return [v.tolist() for v in vectors]
        return [self._embed_hashed(t) for t in texts]

    def embed_one(self, text: str) -> List[float]:
        return self.embed_batch([text])[0]

    def _embed_remote(self, texts: Sequence[str]) -> List[List[float]]:
        payload = json.dumps({"model": self.embed_model, "input": list(texts)}).encode("utf-8")
        req = urllib.request.Request(
            f"{self.api_base}/embeddings",
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                body = json.loads(resp.read().decode("utf-8"))
                ordered = sorted(body["data"], key=lambda item: item["index"])
                return [_l2_normalize(item["embedding"]) for item in ordered]
        except Exception:
            return [self._embed_hashed(t) for t in texts]

    def _embed_hashed(self, text: str) -> List[float]:
        """Deterministic subword + legal-phrase projection into R^dim."""
        vec = [0.0] * self.dim
        tokens = tokenize(text)
        features: List[Tuple[str, float]] = []

        for tok in tokens:
            features.append((f"w:{tok}", 1.0))
            if len(tok) >= 4:
                padded = f"<{tok}>"
                for i in range(len(padded) - 2):
                    features.append((f"c:{padded[i:i+3]}", 0.35))

        for i in range(len(tokens) - 1):
            features.append((f"b:{tokens[i]}_{tokens[i+1]}", 1.35))

        # Project clause taxonomy concepts into shared semantic buckets
        lower = text.lower()
        for category, kws in CLAUSE_TAXONOMY.items():
            for kw in kws:
                if kw in lower:
                    features.append((f"concept:{category}", 1.8))
                    break

        for feat, weight in features:
            digest = hashlib.blake2b(feat.encode("utf-8"), digest_size=8).digest()
            idx = int.from_bytes(digest[:4], "little") % self.dim
            sign = 1.0 if (digest[4] & 1) == 0 else -1.0
            vec[idx] += sign * weight

        return _l2_normalize(vec)



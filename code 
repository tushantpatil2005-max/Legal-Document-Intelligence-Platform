class LegalIndexStore:
    def __init__(self, db_path: str = DEFAULT_DB_PATH) -> None:
        self.db_path = db_path
        self.conn = sqlite3.connect(db_path, check_same_thread=False)
        self._init_schema()

    def _init_schema(self) -> None:
        cur = self.conn.cursor()
        cur.execute(
            """
            CREATE TABLE IF NOT EXISTS documents (
                doc_id TEXT PRIMARY KEY,
                title TEXT NOT NULL,
                doc_type TEXT NOT NULL,
                jurisdiction TEXT NOT NULL,
                effective_date TEXT NOT NULL,
                parties_json TEXT NOT NULL,
                confidentiality TEXT NOT NULL,
                source_path TEXT NOT NULL,
                page_count INTEGER NOT NULL,
                raw_text TEXT NOT NULL
            )
            """
        )
        cur.execute(
            """
            CREATE TABLE IF NOT EXISTS chunks (
                chunk_id TEXT PRIMARY KEY,
                doc_id TEXT NOT NULL,
                doc_title TEXT NOT NULL,
                doc_type TEXT NOT NULL,
                jurisdiction TEXT NOT NULL,
                effective_date TEXT NOT NULL,
                effective_year INTEGER,
                parties_json TEXT NOT NULL,
                confidentiality TEXT NOT NULL,
                page_start INTEGER NOT NULL,
                page_end INTEGER NOT NULL,
                section_number TEXT NOT NULL,
                section_title TEXT NOT NULL,
                clause_category TEXT NOT NULL,
                chunk_index INTEGER NOT NULL,
                char_start INTEGER NOT NULL,
                char_end INTEGER NOT NULL,
                text TEXT NOT NULL,
                embedding_json TEXT NOT NULL,
                FOREIGN KEY(doc_id) REFERENCES documents(doc_id) ON DELETE CASCADE
            )
            """
        )
        cur.execute("CREATE INDEX IF NOT EXISTS idx_chunks_doc_type ON chunks(doc_type)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_chunks_jurisdiction ON chunks(jurisdiction)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_chunks_clause ON chunks(clause_category)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_chunks_doc_id ON chunks(doc_id)")
        self.conn.commit()

    def upsert_document(self, doc: LegalDocument, chunks: Sequence[DocumentChunk]) -> None:
        cur = self.conn.cursor()
        cur.execute("DELETE FROM chunks WHERE doc_id = ?", (doc.doc_id,))
        cur.execute(
            """
            INSERT OR REPLACE INTO documents
            (doc_id, title, doc_type, jurisdiction, effective_date, parties_json,
             confidentiality, source_path, page_count, raw_text)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                doc.doc_id,
                doc.title,
                doc.doc_type,
                doc.jurisdiction,
                doc.effective_date,
                json.dumps(doc.parties),
                doc.confidentiality,
                doc.source_path,
                doc.page_count,
                doc.raw_text,
            ),
        )
        cur.executemany(
            """
            INSERT OR REPLACE INTO chunks
            (chunk_id, doc_id, doc_title, doc_type, jurisdiction, effective_date,
             effective_year, parties_json, confidentiality, page_start, page_end,
             section_number, section_title, clause_category, chunk_index,
             char_start, char_end, text, embedding_json)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            [
                (
                    ch.chunk_id,
                    ch.doc_id,
                    ch.doc_title,
                    ch.doc_type,
                    ch.jurisdiction,
                    ch.effective_date,
                    ch.effective_year,
                    json.dumps(ch.parties),
                    ch.confidentiality,
                    ch.page_start,
                    ch.page_end,
                    ch.section_number,
                    ch.section_title,
                    ch.clause_category,
                    ch.chunk_index,
                    ch.char_start,
                    ch.char_end,
                    ch.text,
                    json.dumps(ch.embedding),
                )
                for ch in chunks
            ],
        )
        self.conn.commit()

    def list_documents(self) -> List[LegalDocument]:
        cur = self.conn.cursor()
        rows = cur.execute(
            """
            SELECT doc_id, title, doc_type, jurisdiction, effective_date,
                   parties_json, confidentiality, source_path, page_count, raw_text
            FROM documents
            ORDER BY title ASC
            """
        ).fetchall()
        return [
            LegalDocument(
                doc_id=r[0],
                title=r[1],
                doc_type=r[2],
                jurisdiction=r[3],
                effective_date=r[4],
                parties=json.loads(r[5]),
                confidentiality=r[6],
                source_path=r[7],
                page_count=r[8],
                raw_text=r[9],
            )
            for r in rows
        ]

    def get_document(self, doc_id: str) -> Optional[LegalDocument]:
        for d in self.list_documents():
            if d.doc_id == doc_id:
                return d
        return None

    def load_chunks(self, doc_id: Optional[str] = None) -> List[DocumentChunk]:
        cur = self.conn.cursor()
        if doc_id:
            rows = cur.execute(
                "SELECT * FROM chunks WHERE doc_id = ? ORDER BY chunk_index ASC",
                (doc_id,),
            ).fetchall()
        else:
            rows = cur.execute("SELECT * FROM chunks ORDER BY doc_id, chunk_index ASC").fetchall()

        results: List[DocumentChunk] = []
        for r in rows:
            results.append(
                DocumentChunk(
                    chunk_id=r[0],
                    doc_id=r[1],
                    doc_title=r[2],
                    doc_type=r[3],
                    jurisdiction=r[4],
                    effective_date=r[5],
                    effective_year=r[6],
                    parties=json.loads(r[7]),
                    confidentiality=r[8],
                    page_start=r[9],
                    page_end=r[10],
                    section_number=r[11],
                    section_title=r[12],
                    clause_category=r[13],
                    chunk_index=r[14],
                    char_start=r[15],
                    char_end=r[16],
                    text=r[17],
                    embedding=json.loads(r[18]),
                )
            )
        return results


# ---------------------------------------------------------------------------
# Grounded Synthesizer & Summarizer
# ---------------------------------------------------------------------------

class LegalSynthesizer:
    """
    Produces cited legal answers and document summaries.
    Uses an OpenAI-compatible chat model when OPENAI_API_KEY is configured,
    and falls back to deterministic extractive synthesis with strict citations
    when running offline.
    """

    def __init__(self) -> None:
        self.api_key = os.environ.get("OPENAI_API_KEY", "").strip()
        self.api_base = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1").rstrip("/")
        self.chat_model = os.environ.get("CHAT_MODEL", "gpt-4o-mini")

    def synthesize_answer(
        self,
        query: str,
        ranked_candidates: List[RetrievalCandidate],
        min_score: float = 0.22,
    ) -> Tuple[str, bool, List[EvidenceSpan]]:
        strong = [c for c in ranked_candidates if c.rerank_score >= min_score]
        if not strong:
            return (
                "Insufficient supporting evidence found in the indexed legal corpus under the active filters. "
                "Try broadening metadata filters or ingesting the relevant governing document.",
                False,
                [],
            )

        evidence: List[EvidenceSpan] = []
        for idx, cand in enumerate(strong, start=1):
            ch = cand.chunk
            evidence.append(
                EvidenceSpan(
                    citation_index=idx,
                    doc_id=ch.doc_id,
                    doc_title=ch.doc_title,
                    page_start=ch.page_start,
                    page_end=ch.page_end,
                    section_number=ch.section_number,
                    section_title=ch.section_title,
                    clause_category=ch.clause_category,
                    quote=ch.text,
                    rerank_score=cand.rerank_score,
                    initial_rank=cand.initial_rank,
                    final_rank=cand.final_rank,
                )
            )

        if self.api_key:
            llm_answer = self._call_llm_qa(query, evidence)
            if llm_answer:
                return llm_answer, True, evidence

        return self._extractive_answer(query, evidence), True, evidence

    def _call_llm_qa(self, query: str, evidence: List[EvidenceSpan]) -> Optional[str]:
        context = "\n\n".join(
            f"[{ev.citation_index}] {ev.doc_title} | Page {ev.page_start}"
            f"{f'-{ev.page_end}' if ev.page_end != ev.page_start else ''} | "
            f"Section {ev.section_number} ({ev.section_title})\n{ev.quote}"
            for ev in evidence
        )
        system_msg = (
            "You are a legal document analyst. Answer the question strictly from the numbered source excerpts. "
            "Cite every factual claim inline using [1], [2], etc. Include document, page, and section references "
            "where helpful. If the excerpts do not answer part of the question, state that clearly without guessing."
        )
        payload = json.dumps({
            "model": self.chat_model,
            "temperature": 0.1,
            "messages": [
                {"role": "system", "content": system_msg},
                {"role": "user", "content": f"Question: {query}\n\nSource Excerpts:\n{context}"},
            ],
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{self.api_base}/chat/completions",
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                body = json.loads(resp.read().decode("utf-8"))
                return str(body["choices"][0]["message"]["content"]).strip()
        except Exception:
            return None

    def _extractive_answer(self, query: str, evidence: List[EvidenceSpan]) -> str:
        q_terms = set(tokenize(query))
        lines: List[str] = []
        for ev in evidence[:4]:
            sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", ev.quote) if len(s.strip()) > 20]
            scored = sorted(
                sentences,
                key=lambda s: len(q_terms & set(tokenize(s))),
                reverse=True,
            )
            best_excerpt = " ".join(scored[:2]) if scored else ev.quote[:320]
            page_ref = f"p. {ev.page_start}" if ev.page_start == ev.page_end else f"pp. {ev.page_start}-{ev.page_end}"
            lines.append(
                f"- {best_excerpt} [{ev.citation_index}: {ev.doc_title}, {page_ref}, Sec. {ev.section_number} ({ev.section_title})]"
            )
        return "Based on the retrieved legal provisions:\n" + "\n".join(lines)

    def summarize_document(self, doc: LegalDocument, chunks: List[DocumentChunk]) -> Dict[str, Any]:
        if self.api_key:
            llm_summary = self._call_llm_summary(doc, chunks)
            if llm_summary:
                return llm_summary

        section_map: Dict[str, List[DocumentChunk]] = defaultdict(list)
        for ch in chunks:
            key = f"{ch.section_number} {ch.section_title}".strip()
            section_map[key].append(ch)

        obligations: List[Dict[str, str]] = []
        thresholds: List[Dict[str, str]] = []
        risk_flags: List[Dict[str, str]] = []

        for ch in chunks:
            page_ref = f"p. {ch.page_start}" if ch.page_start == ch.page_end else f"pp. {ch.page_start}-{ch.page_end}"
            ref = f"{page_ref}, Sec. {ch.section_number} ({ch.section_title})"
            sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", ch.text) if s.strip()]

            for sent in sentences:
                lower = sent.lower()
                if any(m in lower for m in ("shall ", "must ", "agrees to ", "warrants ")):
                    if len(obligations) < 6:
                        obligations.append({"obligation": sent, "reference": ref})
                if re.search(r"(\$\d|\d+%|\b\d+\s*(?:days?|hours?|months?|years?|business days?)\b)", lower):
                    if len(thresholds) < 6:
                        thresholds.append({"term": sent, "reference": ref})
                if any(r in lower for r in ("unlimited", "sole discretion", "indemnify", "cap", "breach", "liquidated", "auto-renew")):
                    if len(risk_flags) < 5:
                        risk_flags.append({
                            "category": ch.clause_category,
                            "detail": sent,
                            "reference": ref,
                        })

        section_outline = [
            {
                "section": sec_label,
                "clause_category": sec_chunks[0].clause_category,
                "pages": (
                    f"p. {sec_chunks[0].page_start}"
                    if sec_chunks[0].page_start == sec_chunks[-1].page_end
                    else f"pp. {sec_chunks[0].page_start}-{sec_chunks[-1].page_end}"
                ),
                "excerpt": sec_chunks[0].text[:240].rstrip() + ("..." if len(sec_chunks[0].text) > 240 else ""),
            }
            for sec_label, sec_chunks in section_map.items()
        ]

        overview = (
            f"{doc.title} is a {doc.doc_type} governed by {doc.jurisdiction} law "
            f"(effective {doc.effective_date}) between {', '.join(doc.parties)}. "
            f"The document spans {doc.page_count} page(s) across {len(section_outline)} indexed section(s)."
        )

        return {
            "doc_id": doc.doc_id,
            "title": doc.title,
            "doc_type": doc.doc_type,
            "jurisdiction": doc.jurisdiction,
            "effective_date": doc.effective_date,
            "parties": doc.parties,
            "executive_overview": overview,
            "key_obligations": obligations,
            "key_thresholds_and_dates": thresholds,
            "risk_considerations": risk_flags,
            "section_outline": section_outline,
        }

    def _call_llm_summary(self, doc: LegalDocument, chunks: List[DocumentChunk]) -> Optional[Dict[str, Any]]:
        condensed = "\n\n".join(
            f"[Page {ch.page_start}, Sec. {ch.section_number} ({ch.section_title})]\n{ch.text}"
            for ch in chunks[:24]
        )
        prompt = (
            "Summarize this legal document into strict JSON with keys: "
            "executive_overview (string), key_obligations (list of {obligation, reference}), "
            "key_thresholds_and_dates (list of {term, reference}), "
            "risk_considerations (list of {category, detail, reference}). "
            "Every reference must cite page and section numbers.\n\n"
            f"Document: {doc.title} ({doc.doc_type}, {doc.jurisdiction}, effective {doc.effective_date})\n\n"
            f"{condensed}"
        )
        payload = json.dumps({
            "model": self.chat_model,
            "temperature": 0.1,
            "response_format": {"type": "json_object"},
            "messages": [
                {"role": "system", "content": "You are a senior corporate counsel preparing an executive brief."},
                {"role": "user", "content": prompt},
            ],
        }).encode("utf-8")
        req = urllib.request.Request(
            f"{self.api_base}/chat/completions",
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                body = json.loads(resp.read().decode("utf-8"))
                parsed = json.loads(body["choices"][0]["message"]["content"])
                parsed.update({
                    "doc_id": doc.doc_id,
                    "title": doc.title,
                    "doc_type": doc.doc_type,
                    "jurisdiction": doc.jurisdiction,
                    "effective_date": doc.effective_date,
                    "parties": doc.parties,
                })
                return parsed
        except Exception:
            return None



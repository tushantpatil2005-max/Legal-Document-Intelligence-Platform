class LegalIntelligencePlatform:
    def __init__(
        self,
        db_path: str = DEFAULT_DB_PATH,
        chunk_words: int = DEFAULT_CHUNK_WORDS,
        overlap_words: int = DEFAULT_CHUNK_OVERLAP,
    ) -> None:
        self.store = LegalIndexStore(db_path)
        self.chunker = LegalChunker(chunk_words=chunk_words, overlap_words=overlap_words)
        self.embedder = EmbeddingClient()
        self.reranker = LegalReranker()
        self.synthesizer = LegalSynthesizer()

    def ingest_document(self, doc: LegalDocument) -> int:
        chunks = self.chunker.chunk_document(doc)
        if not chunks:
            return 0
        texts = [f"{c.doc_title} | {c.section_title} | {c.text}" for c in chunks]
        vectors = self.embedder.embed_batch(texts)
        for ch, vec in zip(chunks, vectors):
            ch.embedding = vec
        self.store.upsert_document(doc, chunks)
        return len(chunks)

    def ingest_file(
        self,
        path: Path,
        doc_type: str = "Contract",
        jurisdiction: str = "Delaware, US",
        effective_date: str = "2025-01-01",
        parties: Optional[List[str]] = None,
        confidentiality: str = "Confidential",
    ) -> int:
        suffix = path.suffix.lower()
        if suffix == ".json":
            data = json.loads(path.read_text(encoding="utf-8"))
            items = data if isinstance(data, list) else [data]
            total = 0
            for item in items:
                doc = LegalDocument(
                    doc_id=item.get("doc_id") or hashlib.sha1(item["title"].encode()).hexdigest()[:12],
                    title=item["title"],
                    doc_type=item.get("doc_type", doc_type),
                    jurisdiction=item.get("jurisdiction", jurisdiction),
                    effective_date=item.get("effective_date", effective_date),
                    parties=item.get("parties", parties or ["Unspecified Parties"]),
                    confidentiality=item.get("confidentiality", confidentiality),
                    source_path=str(path),
                    raw_text=item["text"],
                )
                total += self.ingest_document(doc)
            return total

        if suffix == ".pdf":
            try:
                from pypdf import PdfReader  # type: ignore
                reader = PdfReader(str(path))
                pages = [f"--- Page {i + 1} ---\n{p.extract_text() or ''}" for i, p in enumerate(reader.pages)]
                raw_text = "\n\n".join(pages)
            except ImportError as exc:
                raise RuntimeError("Install 'pypdf' to ingest PDF files: pip install pypdf") from exc
        else:
            raw_text = path.read_text(encoding="utf-8")

        doc_id = hashlib.sha1(str(path.resolve()).encode("utf-8")).hexdigest()[:12]
        doc = LegalDocument(
            doc_id=doc_id,
            title=path.stem.replace("_", " ").replace("-", " ").title(),
            doc_type=doc_type,
            jurisdiction=jurisdiction,
            effective_date=effective_date,
            parties=parties or ["Party A", "Party B"],
            confidentiality=confidentiality,
            source_path=str(path),
            raw_text=raw_text,
        )
        return self.ingest_document(doc)

    def search(
        self,
        query: str,
        filters: Optional[MetadataFilter] = None,
        stage1_k: int = 24,
        top_n: int = 6,
    ) -> Tuple[List[RetrievalCandidate], int]:
        all_chunks = self.store.load_chunks()
        filtered = [ch for ch in all_chunks if filters is None or filters.matches(ch)]
        if not filtered:
            return [], 0

        bm25 = BM25Index(filtered)
        q_vec = self.embedder.embed_one(query)

        dense_scores = {ch.chunk_id: cosine_similarity(q_vec, ch.embedding) for ch in filtered}
        bm25_scores = {ch.chunk_id: bm25.score(query, ch.chunk_id) for ch in filtered}

        dense_order = sorted(filtered, key=lambda c: dense_scores[c.chunk_id], reverse=True)
        bm25_order = sorted(filtered, key=lambda c: bm25_scores[c.chunk_id], reverse=True)

        dense_rank = {ch.chunk_id: i + 1 for i, ch in enumerate(dense_order)}
        bm25_rank = {ch.chunk_id: i + 1 for i, ch in enumerate(bm25_order)}

        rrf_k = 60.0
        candidates: List[RetrievalCandidate] = []
        for ch in filtered:
            rrf = (1.0 / (rrf_k + dense_rank[ch.chunk_id])) + (1.0 / (rrf_k + bm25_rank[ch.chunk_id]))
            candidates.append(
                RetrievalCandidate(
                    chunk=ch,
                    dense_score=round(dense_scores[ch.chunk_id], 4),
                    bm25_score=round(bm25_scores[ch.chunk_id], 4),
                    rrf_score=round(rrf, 6),
                    initial_rank=0,
                )
            )

        candidates.sort(key=lambda c: c.rrf_score, reverse=True)
        shortlist = candidates[:stage1_k]
        for idx, cand in enumerate(shortlist, start=1):
            cand.initial_rank = idx

        reranked = self.reranker.rerank(query, shortlist, top_n=top_n)
        return reranked, len(filtered)

    def answer_question(
        self,
        query: str,
        filters: Optional[MetadataFilter] = None,
        top_n: int = 5,
    ) -> QueryResponse:
        ranked, considered = self.search(query, filters=filters, top_n=top_n)
        answer_text, grounded, citations = self.synthesizer.synthesize_answer(query, ranked)
        return QueryResponse(
            query=query,
            answer=answer_text,
            grounded=grounded,
            citations=citations,
            candidates_considered=considered,
            filters_applied=asdict(filters) if filters else {},
        )

    def find_clauses(
        self,
        clause_category: str,
        filters: Optional[MetadataFilter] = None,
        top_n: int = 10,
    ) -> List[EvidenceSpan]:
        keywords = CLAUSE_TAXONOMY.get(clause_category, [clause_category])
        query = f"{clause_category}: {' '.join(keywords[:6])}"
        effective_filter = filters or MetadataFilter()
        ranked, _ = self.search(query, filters=effective_filter, stage1_k=30, top_n=top_n)

        spans: List[EvidenceSpan] = []
        for idx, cand in enumerate(ranked, start=1):
            ch = cand.chunk
            spans.append(
                EvidenceSpan(
                    citation_index=idx,
                    doc_id=ch.doc_id,
                    doc_title=ch.doc_title,
                    page_start=ch.page_start,
                    page_end=ch.page_end,
                    section_number=ch.section_number,
                    section_title=ch.section_title,
                    clause_category=ch.clause_category,
                    quote=ch.text,
                    rerank_score=cand.rerank_score,
                    initial_rank=cand.initial_rank,
                    final_rank=cand.final_rank,
                )
            )
        return spans

    def summarize_document(self, doc_id: str) -> Dict[str, Any]:
        doc = self.store.get_document(doc_id)
        if not doc:
            raise KeyError(f"Document not found: {doc_id}")
        chunks = self.store.load_chunks(doc_id=doc_id)
        return self.synthesizer.summarize_document(doc, chunks)

    def seed_sample_corpus(self) -> int:
        total = 0
        for sample in SAMPLE_LEGAL_CORPUS:
            total += self.ingest_document(sample)
        return total



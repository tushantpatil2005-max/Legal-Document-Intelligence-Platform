@dataclass
class LegalDocument:
    doc_id: str
    title: str
    doc_type: str
    jurisdiction: str
    effective_date: str
    parties: List[str]
    confidentiality: str = "Internal"
    source_path: str = ""
    raw_text: str = ""
    page_count: int = 1

    @property
    def effective_year(self) -> Optional[int]:
        match = re.search(r"\b(19|20)\d{2}\b", self.effective_date or "")
        return int(match.group(0)) if match else None


@dataclass
class DocumentChunk:
    chunk_id: str
    doc_id: str
    doc_title: str
    doc_type: str
    jurisdiction: str
    effective_date: str
    effective_year: Optional[int]
    parties: List[str]
    confidentiality: str
    page_start: int
    page_end: int
    section_number: str
    section_title: str
    clause_category: str
    chunk_index: int
    char_start: int
    char_end: int
    text: str
    embedding: List[float] = field(default_factory=list)

    @property
    def citation_label(self) -> str:
        page_str = (
            f"p. {self.page_start}"
            if self.page_start == self.page_end
            else f"pp. {self.page_start}-{self.page_end}"
        )
        sec_str = f"Sec. {self.section_number}" if self.section_number else "General"
        if self.section_title:
            sec_str = f"{sec_str} ({self.section_title})"
        return f"{self.doc_title}, {page_str}, {sec_str}"


@dataclass
class MetadataFilter:
    doc_ids: Optional[List[str]] = None
    doc_types: Optional[List[str]] = None
    jurisdictions: Optional[List[str]] = None
    parties: Optional[List[str]] = None
    clause_categories: Optional[List[str]] = None
    confidentiality: Optional[List[str]] = None
    year_from: Optional[int] = None
    year_to: Optional[int] = None

    def matches(self, chunk: DocumentChunk) -> bool:
        if self.doc_ids and chunk.doc_id not in self.doc_ids:
            return False
        if self.doc_types and chunk.doc_type.lower() not in {d.lower() for d in self.doc_types}:
            return False
        if self.jurisdictions and chunk.jurisdiction.lower() not in {j.lower() for j in self.jurisdictions}:
            return False
        if self.confidentiality and chunk.confidentiality.lower() not in {c.lower() for c in self.confidentiality}:
            return False
        if self.clause_categories and chunk.clause_category.lower() not in {c.lower() for c in self.clause_categories}:
            return False
        if self.parties:
            chunk_parties = " ".join(chunk.parties).lower()
            if not any(p.lower() in chunk_parties for p in self.parties):
                return False
        if self.year_from is not None:
            if chunk.effective_year is None or chunk.effective_year < self.year_from:
                return False
        if self.year_to is not None:
            if chunk.effective_year is None or chunk.effective_year > self.year_to:
                return False
        return True



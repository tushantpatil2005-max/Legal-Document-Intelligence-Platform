class BM25Index:
    def __init__(self, chunks: Sequence[DocumentChunk], k1: float = 1.5, b: float = 0.75) -> None:
        self.k1 = k1
        self.b = b
        self.doc_count = len(chunks)
        self.doc_freqs: Dict[str, int] = defaultdict(int)
        self.term_freqs: Dict[str, Counter] = {}
        self.doc_lengths: Dict[str, int] = {}

        total_len = 0
        for ch in chunks:
            toks = tokenize(f"{ch.section_title} {ch.clause_category} {ch.text}")
            counts = Counter(toks)
            self.term_freqs[ch.chunk_id] = counts
            self.doc_lengths[ch.chunk_id] = len(toks)
            total_len += len(toks)
            for term in counts:
                self.doc_freqs[term] += 1

        self.avg_len = (total_len / self.doc_count) if self.doc_count else 1.0

    def score(self, query: str, chunk_id: str) -> float:
        q_terms = tokenize(query)
        tf_map = self.term_freqs.get(chunk_id)
        if not tf_map or not q_terms:
            return 0.0
        dl = self.doc_lengths[chunk_id]
        total = 0.0
        for term in q_terms:
            tf = tf_map.get(term, 0)
            if tf == 0:
                continue
            df = self.doc_freqs.get(term, 0)
            idf = math.log(1.0 + (self.doc_count - df + 0.5) / (df + 0.5))
            denom = tf + self.k1 * (1.0 - self.b + self.b * (dl / self.avg_len))
            total += idf * ((tf * (self.k1 + 1.0)) / denom)
        return total


